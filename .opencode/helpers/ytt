#!/usr/bin/env bash

# ytt - YouTube Transcript Tool
# Uses yt-dlp to extract transcripts from YouTube videos
# Usage: ytt <youtube_url> [output_file]

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to show usage
show_usage() {
    cat << EOF
ytt - YouTube Transcript Tool

USAGE:
    ytt <youtube_url> [output_file]

ARGUMENTS:
    youtube_url     YouTube video URL
    output_file     Optional output file (default: auto-generated from video title)

OPTIONS:
    -h, --help      Show this help message
    -v, --verbose   Verbose output
    -f, --format    Transcript format (txt, srt, vtt) [default: txt]
    -l, --lang      Language code (en, es, fr, etc.) [default: auto]
    --list-subs     List available subtitle languages for the video

EXAMPLES:
    ytt "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    ytt "https://www.youtube.com/watch?v=dQw4w9WgXcQ" "transcript.txt"
    ytt -f srt "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    ytt -l es "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    ytt --list-subs "https://www.youtube.com/watch?v=dQw4w9WgXcQ"

FEATURES:
    • Extracts automatic and manual subtitles
    • Supports multiple output formats (txt, srt, vtt)
    • Auto-generates meaningful filenames from video titles
    • Handles multiple languages
    • Clean text output with timestamps (optional)
    • Error handling and validation

EOF
}

# Default values
VERBOSE=false
FORMAT="txt"
LANGUAGE=""
OUTPUT_FILE=""
LIST_SUBS=false
URL=""

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_usage
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -f|--format)
            FORMAT="$2"
            shift 2
            ;;
        -l|--lang)
            LANGUAGE="$2"
            shift 2
            ;;
        --list-subs)
            LIST_SUBS=true
            shift
            ;;
        -*)
            print_error "Unknown option: $1"
            echo
            show_usage
            exit 1
            ;;
        *)
            if [[ -z "$URL" ]]; then
                URL="$1"
            elif [[ -z "$OUTPUT_FILE" ]]; then
                OUTPUT_FILE="$1"
            else
                print_error "Too many arguments"
                show_usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate URL
if [[ -z "$URL" ]]; then
    print_error "YouTube URL is required"
    echo
    show_usage
    exit 1
fi

# Validate URL format
if [[ ! "$URL" =~ youtube\.com|youtu\.be ]]; then
    print_error "Invalid YouTube URL: $URL"
    exit 1
fi

# Function to list available subtitles
list_subtitles() {
    print_info "Checking available subtitles for: $URL"
    yt-dlp --list-subs "$URL" 2>/dev/null || {
        print_error "Failed to list subtitles. Check if the video exists and has subtitles."
        exit 1
    }
}

# Function to get video info
get_video_info() {
    local video_title
    video_title=$(yt-dlp --get-title "$URL" 2>/dev/null) || {
        print_error "Failed to get video information. Check if the URL is valid."
        exit 1
    }
    echo "$video_title"
}

# Function to sanitize filename
sanitize_filename() {
    local filename="$1"
    # Remove special characters and replace spaces with underscores
    echo "$filename" | sed 's/[^a-zA-Z0-9._-]/_/g' | sed 's/__*/_/g' | sed 's/^_\|_$//g'
}

# Function to extract transcript
extract_transcript() {
    local url="$1"
    local output_file="$2"
    local format="$3"
    local language="$4"
    
    # Build yt-dlp command
    local cmd="yt-dlp --skip-download --write-auto-subs"
    
    # Add manual subs as fallback
    cmd+=" --write-subs"
    
    # Set subtitle format
    case "$format" in
        txt)
            cmd+=" --sub-format best"
            ;;
        srt)
            cmd+=" --sub-format srt"
            ;;
        vtt)
            cmd+=" --sub-format vtt"
            ;;
        *)
            print_error "Unsupported format: $format"
            exit 1
            ;;
    esac
    
    # Set language if specified
    if [[ -n "$language" ]]; then
        cmd+=" --sub-langs $language"
    fi
    
    # Set output template
    local output_template
    if [[ -n "$output_file" ]]; then
        # Use user-specified filename
        local base_name="${output_file%.*}"
        output_template="${base_name}.%(ext)s"
    else
        # Auto-generate filename from video title
        output_template="%(title)s.%(ext)s"
    fi
    
    cmd+=" -o '$output_template'"
    
    if [[ "$VERBOSE" == true ]]; then
        print_info "Executing: $cmd $url"
    fi
    
    # Execute the command
    eval "$cmd '$url'" || {
        print_error "Failed to extract transcript. The video might not have subtitles."
        exit 1
    }
}

# Function to process extracted subtitle files
process_subtitle_files() {
    local base_name="$1"
    local target_format="$2"
    
    # Find generated subtitle files
    local subtitle_files
    subtitle_files=(*.{vtt,srt})
    
    # Remove non-existent files from the array
    for i in "${!subtitle_files[@]}"; do
        [[ -f "${subtitle_files[$i]}" ]] || unset "subtitle_files[$i]"
    done
    
    if [[ ${#subtitle_files[@]} -eq 0 ]]; then
        print_warning "No subtitle files found"
        return 1
    fi
    
    # Process each subtitle file
    for subtitle_file in "${subtitle_files[@]}"; do
        if [[ -f "$subtitle_file" ]]; then
            print_success "Downloaded: $subtitle_file"
            
            # Convert to plain text if requested
            if [[ "$target_format" == "txt" ]]; then
                local txt_file="${subtitle_file%.*}.txt"
                convert_to_txt "$subtitle_file" "$txt_file"
                
                # Remove original subtitle file if conversion successful
                if [[ -f "$txt_file" ]]; then
                    rm "$subtitle_file"
                    print_success "Converted to plain text: $txt_file"
                fi
            fi
        fi
    done
}

# Function to convert subtitle file to plain text
convert_to_txt() {
    local input_file="$1"
    local output_file="$2"
    
    if [[ ! -f "$input_file" ]]; then
        print_error "Input file not found: $input_file"
        return 1
    fi
    
    # Convert based on input format
    if [[ "$input_file" =~ \.vtt$ ]]; then
        # Convert VTT to plain text
        sed -e '/^WEBVTT/d' -e '/^$/d' -e '/^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/d' -e '/^NOTE/d' -e 's/<[^>]*>//g' "$input_file" | \
        awk 'NF' > "$output_file"
    elif [[ "$input_file" =~ \.srt$ ]]; then
        # Convert SRT to plain text
        sed -e '/^[0-9]*$/d' -e '/^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/d' -e '/^$/d' -e 's/<[^>]*>//g' "$input_file" | \
        awk 'NF' > "$output_file"
    else
        print_error "Unsupported subtitle format: $input_file"
        return 1
    fi
    
    if [[ ! -s "$output_file" ]]; then
        print_error "Failed to convert $input_file to text"
        rm -f "$output_file"
        return 1
    fi
}

# Main execution
main() {
    print_info "YouTube Transcript Tool (ytt)"
    echo
    
    # List subtitles if requested
    if [[ "$LIST_SUBS" == true ]]; then
        list_subtitles
        exit 0
    fi
    
    # Get video info
    print_info "Getting video information..."
    local video_title
    video_title=$(get_video_info)
    print_info "Video: $video_title"
    
    # Generate output filename if not provided
    if [[ -z "$OUTPUT_FILE" ]]; then
        local sanitized_title
        sanitized_title=$(sanitize_filename "$video_title")
        OUTPUT_FILE="${sanitized_title}.${FORMAT}"
    fi
    
    print_info "Output format: $FORMAT"
    if [[ -n "$LANGUAGE" ]]; then
        print_info "Language: $LANGUAGE"
    fi
    echo
    
    # Extract transcript
    print_info "Extracting transcript..."
    extract_transcript "$URL" "$OUTPUT_FILE" "$FORMAT" "$LANGUAGE"
    
    # Process the downloaded files
    local base_name="${OUTPUT_FILE%.*}"
    process_subtitle_files "$base_name" "$FORMAT"
    
    echo
    print_success "Transcript extraction completed!"
}

# Run main function
main